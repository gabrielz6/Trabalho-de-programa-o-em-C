#include <stdio.h> // biblioteca padrão

int main() { // função principal
    int matriz[2][2]; // cria matriz 2x2
    int i, j; // variáveis de controle
    int soma = 0; // variável para soma

    for (i = 0; i < 2; i++) { // percorre linhas
        for (j = 0; j < 2; j++) { // percorre colunas
            printf("Digite um valor: "); // pede valor
            scanf("%d", &matriz[i][j]); // armazena na matriz
            soma += matriz[i][j]; // soma os valores
        }
    }

    printf("Soma total: %d\n", soma); // mostra soma

    return 0; // fim
}

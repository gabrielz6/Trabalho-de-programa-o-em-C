#include <stdio.h> // Biblioteca padrão para entrada e saída de dados

int main() { // Função principal onde o prpgrama começa a ser executado 

    
    float num1, num2;// Declaração das variáveis

    float soma, subtracao, multiplicacao, divisao;// Variáveis para armazenar os resultados das operações
    
    printf("Digite o primeiro numero: ");// Solicita ao usuário o primeiro número
    scanf("%f", &num1);//Lê um número decimal (float) digitado pelo usuário e armazena na variável num1

    printf("Digite o segundo numero: ");// Solicita ao usuário o segundo número
    scanf("%f", &num2);//Lê um número decimal (float) digitado pelo usuário e armazena na variável num2

    soma = num1 + num2;// Realiza a soma dos números

    subtracao = num1 - num2;// Realiza a subtração dos números

    multiplicacao = num1 * num2;// Realiza a multiplicação dos números

    divisao = num1 / num2;// Realiza a divisão dos números

    printf("\nResultado das operacoes:\n");// Exibe os resultados das operações

    printf("Soma: %.2f\n", soma);// Exibe o resultado da soma

    printf("Subtracao: %.2f\n", subtracao);// Exibe o resultado da subtração

    printf("Multiplicacao: %.2f\n", multiplicacao);// Exibe o resultado da multiplicação

    printf("Divisao: %.2f\n", divisao);// Exibe o resultado da divisão

    return 0;// Retorna 0 indicando que o programa terminou corretamente
}

#include <stdio.h> // biblioteca padrão

int main() { // função principal
    int i, num, soma = 0; // variáveis

    for (i = 1; i <= 5; i++) { // repete 5 vezes
        printf("Digite um numero: "); // pede número
        scanf("%d", &num); // lê número
        soma += num; // soma acumulada
    }

    printf("Soma total: %d\n", soma); // mostra soma

    return 0; // fim
}
